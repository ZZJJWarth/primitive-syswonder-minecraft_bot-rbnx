# Required only when JDK 17 is not installed at the package default path.
JAVA17_HOME=/path/to/temurin-17

# Required only when ROS 2 Jazzy or Humble is not installed under /opt/ros.
RBNX_MINECRAFT_ROS_SETUP=/opt/ros/jazzy/setup.bash

# Minecraft server and development-client settings.
MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=robonix_agent
MC_CLIENT_WIDTH=1280
MC_CLIENT_HEIGHT=720

# Select 1 for the managed NVIDIA Xorg launcher or 0 for the inherited DISPLAY.
RBNX_MINECRAFT_USE_NVIDIA=0
MC_NVIDIA_DISPLAY=48

# Local Forge Mod command connection.
RBNX_MINECRAFT_MOD_HOST=127.0.0.1
RBNX_MINECRAFT_MOD_PORT=25576
RBNX_MINECRAFT_MOD_TIMEOUT_SEC=35
RBNX_MINECRAFT_MOD_READY_TIMEOUT_MS=30000

# Server-chat frontend. An empty allowlist permits every server player.
RBNX_MINECRAFT_CHAT_ENABLED=1
RBNX_MINECRAFT_CHAT_PREFIX=@bot
# RBNX_MINECRAFT_CHAT_ALLOWED_PLAYERS=player-uuid,operator-name
RBNX_MINECRAFT_CHAT_PROGRESS_SEC=5
ROBONIX_LIAISON_ENDPOINT=127.0.0.1:50081

# Local framebuffer viewer. Keep the default loopback bind unless the network is trusted.
RBNX_MINECRAFT_VIEWER_HOST=127.0.0.1
RBNX_MINECRAFT_VIEWER_PORT=8765
RBNX_MINECRAFT_VIEWER_INTERVAL_MS=200
# RBNX_MINECRAFT_VIEWER_ALLOWED_HOST=

# Stream rates and capture settings.
RBNX_MINECRAFT_CAMERA_STREAM_HZ=5
RBNX_MINECRAFT_ODOM_HZ=10
RBNX_MINECRAFT_CAPTURE_INTERVAL_MS=200
RBNX_MINECRAFT_CAPTURE_WIDTH=960
RBNX_MINECRAFT_CAPTURE_HEIGHT=540
RBNX_MINECRAFT_JPEG_QUALITY=0.8
RBNX_MINECRAFT_BLOCK_RADIUS=5
RBNX_MINECRAFT_EYE_HEIGHT=1.62

# Optional ROS 2 topic and frame overrides.
RBNX_MINECRAFT_RGB_TOPIC=/minecraft/camera/rgb
RBNX_MINECRAFT_DEPTH_TOPIC=/minecraft/camera/depth
RBNX_MINECRAFT_EXTRINSICS_TOPIC=/minecraft/camera/extrinsics
RBNX_MINECRAFT_INTRINSICS_TOPIC=/minecraft/camera/intrinsics
RBNX_MINECRAFT_ODOM_TOPIC=/minecraft/chassis/odom
RBNX_MINECRAFT_OBJECTS_TOPIC=/minecraft/perception/objects
RBNX_MINECRAFT_CAMERA_FRAME_ID=minecraft_camera_optical_frame
RBNX_MINECRAFT_BASE_FRAME_ID=minecraft_view_base
RBNX_MINECRAFT_ODOM_FRAME_ID=minecraft_odom
